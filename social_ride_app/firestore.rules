rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the current user has already joined this ride (has a rider doc).
    function isRideMember(rideId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rides/$(rideId)/riders/$(request.auth.uid));
    }

    match /rides/{rideId} {
      // get: any signed-in user (needed to validate a join code before
      // membership exists). list: denied so rides cannot be enumerated.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasAll(['name', 'creatorId', 'status']);

      // Only the creator can update a ride doc, and only for one of two
      // narrow reasons — tune drop-off thresholds, or end the ride.
      allow update: if isSignedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.name == resource.data.name
        && (
          (request.resource.data.status == resource.data.status
            && request.resource.data.dropoffThresholdMeters is number
            && request.resource.data.dropoffThresholdMeters >= 50
            && request.resource.data.dropoffThresholdMeters <= 1000
            && request.resource.data.dropoffDwellSeconds is number
            && request.resource.data.dropoffDwellSeconds >= 10
            && request.resource.data.dropoffDwellSeconds <= 300)
          ||
          (request.resource.data.status == 'ended'
            && request.resource.data.dropoffThresholdMeters ==
               resource.data.dropoffThresholdMeters
            && request.resource.data.dropoffDwellSeconds ==
               resource.data.dropoffDwellSeconds)
        );
      allow delete: if false;

      match /riders/{userId} {
        // Live positions are visible only to people already in the ride.
        allow read: if isRideMember(rideId);

        // Only the rider themself can write their own doc.
        // Basic field hygiene: no spoofing another uid, reasonable lat/lng.
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAny(['displayName', 'state']);
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && (!('lat' in request.resource.data)
              || (request.resource.data.lat is number
                  && request.resource.data.lat >= -90
                  && request.resource.data.lat <= 90))
          && (!('lng' in request.resource.data)
              || (request.resource.data.lng is number
                  && request.resource.data.lng >= -180
                  && request.resource.data.lng <= 180));
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /track/{pointId} {
        // Trail is visible only to members; only the creator may append.
        allow read: if isRideMember(rideId);
        allow create: if isRideMember(rideId)
          && request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.creatorId
          && request.resource.data.keys().hasAll(['lat', 'lng']);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
