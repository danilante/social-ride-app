rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /rides/{rideId}/riders/{userId}/dropoff_audio.m4a {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
