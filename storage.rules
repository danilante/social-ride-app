rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirror Firestore membership: only riders in the ride can hear drop-off audio.
    function isRideMember(rideId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/rides/$(rideId)/riders/$(request.auth.uid));
    }

    match /rides/{rideId}/riders/{userId}/dropoff_audio.m4a {
      allow read: if isRideMember(rideId);
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
